<section data-native-loyalty-shop
         data-state-url="{{ path('frontend.loyaltyshop.state') }}"
         data-cart-url="{{ path('frontend.loyaltyshop.cart.add') }}"
         data-discount-url="{{ path('frontend.loyaltyshop.discount.claim') }}"
         data-points-name="{{ pointsName }}"
         data-error-message="{{ 'leShop.error'|trans }}"
         data-balance-message="{{ 'leShop.balance'|trans }}"
         data-insufficient-message="{{ 'leShop.insufficient'|trans }}">
    <div class="alert alert-info" data-loyalty-balance role="status">
        <a href="{{ path('frontend.account.login.page') }}">{{ 'leShop.login'|trans|sw_sanitize }}</a>
    </div>
    <p class="text-muted">{{ 'leShop.balanceNote'|trans|sw_sanitize }}</p>
    <div class="alert d-none" data-loyalty-message role="status" aria-live="polite"></div>
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <span>{{ listing.total }} {{ 'leShop.rewards'|trans|sw_sanitize }}</span>
        <form method="get" class="d-flex align-items-center gap-2">
            <label>{{ 'leShop.sort'|trans|sw_sanitize }}
                <select name="leSort" class="form-select">
                    <option value="name" {% if app.request.query.get('leSort') != 'points' %}selected{% endif %}>{{ 'leShop.name'|trans|sw_sanitize }}</option>
                    <option value="points" {% if app.request.query.get('leSort') == 'points' %}selected{% endif %}>{{ pointsName }}</option>
                </select>
            </label>
            <button type="submit" class="btn btn-outline-primary">{{ 'leShop.apply'|trans|sw_sanitize }}</button>
        </form>
    </div>
    <div class="row g-4">
        {% for product in listing.products %}
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <article class="card h-100 product-box">
                    <div class="card-body d-flex flex-column">
                        {% if product.image_link %}
                            <img src="{{ product.image_link }}" alt="{{ product.title }}" loading="lazy" class="img-fluid mb-3" style="height:180px;object-fit:contain;width:100%">
                        {% endif %}
                        <h2 class="h5">{{ product.title }}</h2>
                        <p class="fw-bold fs-4 mt-auto">{{ product.coin_price }} <span class="fs-6">{{ pointsName }}</span></p>
                        {% if product.minimum_required_tier_id %}<p class="small text-muted">{{ 'leShop.minimumTier'|trans|sw_sanitize }} {{ product.minimum_required_tier_id }}</p>{% endif %}
                        <button type="button" class="btn btn-primary w-100" disabled
                                data-loyalty-redeem data-sku="{{ product.id }}" data-type="{{ product.type }}"
                                data-price="{{ product.coin_price }}" data-available="{{ product.available ? '1' : '0' }}">
                            {{ (product.available ? 'leShop.redeem' : 'leShop.unavailable')|trans|sw_sanitize }}
                        </button>
                    </div>
                </article>
            </div>
        {% else %}
            <p>{{ 'leShop.empty'|trans|sw_sanitize }}</p>
        {% endfor %}
    </div>
    {% if listing.pages > 1 %}
        <nav class="mt-4" aria-label="{{ 'leShop.pages'|trans }}"><ul class="pagination flex-wrap">
            {% for number in 1..listing.pages %}
                <li class="page-item {{ number == listing.page ? 'active' : '' }}">
                    <a class="page-link" href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge(app.request.query.all)|merge({lePage: number})) }}" {% if number == listing.page %}aria-current="page"{% endif %}>{{ number }}</a>
                </li>
            {% endfor %}
        </ul></nav>
    {% endif %}
    <noscript><p>{{ 'leShop.javascript'|trans|sw_sanitize }}</p></noscript>
</section>
