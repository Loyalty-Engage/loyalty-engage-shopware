<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="LoyaltyEngage\Subscriber\LoyaltyShopCacheSubscriber">
            <tag name="kernel.event_subscriber"/>
        </service>
        <service id="LoyaltyEngage\Command\LoyaltyFeedRefreshCommand">
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyFeedReader"/>
            <tag name="console.command"/>
        </service>
        <service id="LoyaltyEngage\Service\LoyaltyFeedReader">
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyShopConfig"/>
            <argument type="service" id="Symfony\Contracts\HttpClient\HttpClientInterface"/>
            <argument type="service" id="cache.object"/>
            <argument type="service" id="logger"/>
        </service>
        <service id="LoyaltyEngage\Service\LoyaltyProductFeed">
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyProductCatalog"/>
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyShopConfig"/>
            <argument type="service" id="Shopware\Core\System\SalesChannel\Context\SalesChannelContextFactory"/>
            <argument type="service" id="sales_channel.repository"/>
        </service>
        <service id="LoyaltyEngage\Service\RewardAuthorization">
            <argument>%kernel.secret%</argument>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>
        <service id="LoyaltyEngage\Subscriber\ManagedRewardLifecycleSubscriber">
            <argument type="service" id="LoyaltyEngage\Service\RewardAuthorization"/>
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyEngageApiService"/>
            <tag name="kernel.event_subscriber"/>
        </service>
        <service id="LoyaltyEngage\Command\LoyaltyShopDemoCommand">
            <argument type="service" id="product.repository"/>
            <argument type="service" id="sales_channel.repository"/>
            <argument type="service" id="tax.repository"/>
            <argument type="service" id="cms_page.repository"/>
            <argument type="service" id="landing_page.repository"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <tag name="console.command"/>
        </service>
        <service id="LoyaltyEngage\Service\LoyaltyShopConfig">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>
        <service id="LoyaltyEngage\Service\LoyaltyProductCatalog">
            <argument type="service" id="product.repository"/>
            <argument type="service" id="language.repository"/>
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyShopConfig"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyFeedReader"/>
        </service>
        <service id="LoyaltyEngage\Service\LoyaltyShopEligibility">
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyShopConfig"/>
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyProductCatalog"/>
        </service>
        <service id="LoyaltyEngage\Service\ManagedRewardService">
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyProductCatalog"/>
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyShopEligibility"/>
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyShopService"/>
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyEngageApiService"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\SalesChannel\CartService"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="LoyaltyEngage\Service\RewardAuthorization"/>
        </service>
        <service id="LoyaltyEngage\Cart\LoyaltyShopCartValidator">
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyProductCatalog"/>
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyShopEligibility"/>
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyShopConfig"/>
            <argument type="service" id="LoyaltyEngage\Service\RewardAuthorization"/>
            <tag name="shopware.cart.validator"/>
        </service>
        <service id="LoyaltyEngage\Cms\LoyaltyShopCmsResolver">
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyProductCatalog"/>
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyShopConfig"/>
            <tag name="shopware.cms.data_resolver"/>
        </service>
        <service id="LoyaltyEngage\Controller\Storefront\LoyaltyCatalogController" public="true">
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyProductCatalog"/>
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyShopConfig"/>
            <argument type="service" id="Shopware\Storefront\Page\GenericPageLoader"/>
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyProductFeed"/>
            <call method="setContainer"><argument type="service" id="service_container"/></call>
            <tag name="controller.service_arguments"/>
        </service>
        <!-- API Service -->
        <service id="LoyaltyEngage\Service\LoyaltyEngageApiService">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="Symfony\Contracts\HttpClient\HttpClientInterface"/>
            <argument type="service" id="logger"/>
        </service>

        <!-- Cart Service -->
        <service id="LoyaltyEngage\Service\LoyaltyCartService">
            <argument type="service" id="Shopware\Core\Checkout\Cart\SalesChannel\CartService"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\CartPersister"/>
            <argument type="service" id="product.repository"/>
            <argument type="service" id="promotion.repository"/>
            <argument type="service" id="promotion_discount.repository"/>
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyEngageApiService"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyShopConfig"/>
            <argument type="service" id="LoyaltyEngage\Service\ManagedRewardService"/>
        </service>

        <!-- Loyalty Shop Service (storefront widget) -->
        <service id="LoyaltyEngage\Service\LoyaltyShopService">
            <argument type="service" id="Shopware\Core\Checkout\Cart\SalesChannel\CartService"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\CartPersister"/>
            <argument type="service" id="product.repository"/>
            <argument type="service" id="promotion.repository"/>
            <argument type="service" id="promotion_individual_code.repository"/>
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyEngageApiService"/>
            <argument type="service" id="logger"/>
        </service>

        <!-- Storefront Controller (loyalty shop widget endpoints) -->
        <service id="LoyaltyEngage\Controller\Storefront\LoyaltyShopController" public="true">
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyShopService"/>
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyShopConfig"/>
            <argument type="service" id="LoyaltyEngage\Service\ManagedRewardService"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
            <tag name="controller.service_arguments"/>
        </service>

        <!-- API Controllers -->
        <service id="LoyaltyEngage\Controller\Api\LoyaltyCartController" public="true">
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyCartService"/>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="LoyaltyEngage\Controller\Api\CustomerLoyaltyController" public="true">
            <argument type="service" id="LoyaltyEngage\Service\CustomerLoyaltyService"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
            <tag name="controller.service_arguments"/>
        </service>

        <!-- Customer Loyalty Service -->
        <service id="LoyaltyEngage\Service\CustomerLoyaltyService">
            <argument type="service" id="customer.repository"/>
            <argument type="service" id="logger"/>
        </service>

        <!-- Points Redemption Service -->
        <service id="LoyaltyEngage\Service\PointsRedemptionService">
            <argument type="service" id="Shopware\Core\Checkout\Cart\SalesChannel\CartService"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\CartPersister"/>
            <argument type="service" id="customer.repository"/>
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyEngageApiService"/>
            <argument type="service" id="logger"/>
        </service>

        <!-- SRS Discount Validator: checks LoyaltyEngage codes against SRS API before checkout -->
        <service id="LoyaltyEngage\Cart\SrsDiscountValidator">
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyEngageApiService"/>
            <argument type="service" id="promotion_individual_code.repository"/>
            <argument type="service" id="promotion.repository"/>
            <argument type="service" id="logger"/>
            <tag name="shopware.cart.validator"/>
        </service>

        <!-- Loyalty Discount Cart Collector/Processor -->
        <service id="LoyaltyEngage\Cart\LoyaltyDiscountCollector">
            <argument type="service" id="Shopware\Core\Checkout\Cart\Price\AbsolutePriceCalculator"/>
            <tag name="shopware.cart.collector" priority="-5000"/>
            <tag name="shopware.cart.processor" priority="-5000"/>
        </service>

        <!-- Loyalty Free Product Processor: forces loyalty product prices to €0.
             Must run AFTER Shopware's default product processor (priority 5000)
             but BEFORE Shopware's PromotionProcessor (priority 4900), so that
             discount codes calculate on the already-zeroed price.
             Priority 4950 ensures correct ordering (between 5000 and 4900). -->
        <service id="LoyaltyEngage\Cart\LoyaltyFreeProductProcessor">
            <argument type="service" id="Shopware\Core\Checkout\Cart\Price\QuantityPriceCalculator"/>
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyShopConfig"/>
            <argument type="service" id="LoyaltyEngage\Service\RewardAuthorization"/>
            <tag name="shopware.cart.processor" priority="4950"/>
        </service>

        <!-- Points Redemption Controller -->
        <service id="LoyaltyEngage\Controller\Api\PointsRedemptionController" public="true">
            <argument type="service" id="LoyaltyEngage\Service\PointsRedemptionService"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
            <tag name="controller.service_arguments"/>
        </service>

        <!-- Message Handlers -->
        <service id="LoyaltyEngage\Message\Handler\PurchaseMessageHandler">
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyEngageApiService"/>
            <argument type="service" id="logger"/>
            <tag name="messenger.message_handler"/>
        </service>

        <service id="LoyaltyEngage\Message\Handler\ReturnMessageHandler">
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyEngageApiService"/>
            <argument type="service" id="logger"/>
            <tag name="messenger.message_handler"/>
        </service>

        <service id="LoyaltyEngage\Message\Handler\FreeProductPurchaseMessageHandler">
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyEngageApiService"/>
            <argument type="service" id="logger"/>
            <tag name="messenger.message_handler"/>
        </service>

        <service id="LoyaltyEngage\Message\Handler\FreeProductRemoveMessageHandler">
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyEngageApiService"/>
            <argument type="service" id="logger"/>
            <tag name="messenger.message_handler"/>
        </service>

        <!-- Event Subscribers -->
        <service id="LoyaltyEngage\Subscriber\PurchaseSubscriber">
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyEngageApiService"/>
            <argument type="service" id="order.repository"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="messenger.default_bus"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="LoyaltyEngage\Subscriber\ReturnSubscriber">
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyEngageApiService"/>
            <argument type="service" id="order_delivery.repository"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="messenger.default_bus"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="LoyaltyEngage\Subscriber\FreeProductPurchaseSubscriber">
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyEngageApiService"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="messenger.default_bus"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="LoyaltyEngage\Subscriber\FreeProductRemoveSubscriber">
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyEngageApiService"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="messenger.default_bus"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <!-- Discount Redemption Subscriber: marks LoyaltyEngage codes as redeemed and removes them from Shopware after order placement -->
        <service id="LoyaltyEngage\Subscriber\DiscountRedemptionSubscriber">
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyEngageApiService"/>
            <argument type="service" id="promotion_individual_code.repository"/>
            <argument type="service" id="logger"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <!-- SRS Discount Added Subscriber: validates LoyaltyEngage codes against SRS API when added to cart -->
        <service id="LoyaltyEngage\Subscriber\SrsDiscountAddedSubscriber">
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyEngageApiService"/>
            <argument type="service" id="promotion_individual_code.repository"/>
            <argument type="service" id="promotion.repository"/>
            <argument type="service" id="logger"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <!-- Checkout Subscriber for Points Redemption Block -->
        <service id="LoyaltyEngage\Subscriber\CheckoutSubscriber">
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyEngageApiService"/>
            <argument type="service" id="customer.repository"/>
            <argument type="service" id="logger"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <!-- Rule Conditions -->
        <service id="LoyaltyEngage\Core\Rule\CustomerTierRule">
            <tag name="shopware.rule.definition"/>
        </service>

        <service id="LoyaltyEngage\Core\Rule\CustomerPointsRule">
            <tag name="shopware.rule.definition"/>
        </service>

        <service id="LoyaltyEngage\Core\Rule\CustomerCoinsRule">
            <tag name="shopware.rule.definition"/>
        </service>

        <!-- Scheduled Tasks -->
        <service id="LoyaltyEngage\Scheduled\CartExpiryTask">
            <tag name="shopware.scheduled.task" />
        </service>

        <!-- CartExpiryTaskHandler: run() is intentionally empty (disabled).
             The original logic called removeAllItems() per order which caused
             rate-limiting. Cart cleanup now happens only via FreeProductRemoveSubscriber. -->
        <service id="LoyaltyEngage\Scheduled\CartExpiryTaskHandler">
            <argument type="service" id="scheduled_task.repository" />
            <argument type="service" id="logger" />
            <tag name="messenger.message_handler"/>
        </service>

        <service id="LoyaltyEngage\Scheduled\OrderPlaceTask">
            <tag name="shopware.scheduled.task" />
        </service>

        <service id="LoyaltyEngage\Scheduled\OrderPlaceTaskHandler">
            <argument type="service" id="scheduled_task.repository" />
            <argument type="service" id="order.repository" />
            <argument type="service" id="LoyaltyEngage\Service\LoyaltyEngageApiService" />
            <argument type="service" id="logger" />
            <tag name="messenger.message_handler"/>
        </service>
    </services>
</container>
